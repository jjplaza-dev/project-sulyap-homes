# Sulyap Homes & Leasing: environment variables.
# Copy this file to `.env.local` (which must stay out of git) and fill in the values.
# This file lists NAMES ONLY. Never commit real values or tokens.

# --- Sanity (Phase 3) ---------------------------------------------------------
# Project ID and dataset are public identifiers. Create them in the Sanity dashboard (U-01).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# API version date. Leave blank to use the default in sanity/env.ts.
NEXT_PUBLIC_SANITY_API_VERSION=

# Server-only. Needed only if the dataset is PRIVATE (recommended once real content is added).
# Create a "Viewer" read token in the Sanity dashboard. Never prefix it with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# --- Site (server-only) -------------------------------------------------------
# Central administrator email. Kept out of Sanity on purpose: a public dataset can be read by anyone.
# Used for inquiry notifications from Phase 5.
CENTRAL_ADMIN_EMAIL=

# --- Added in later phases (names will be finalized then) ---------------------
# Phase 4: Google Maps browser key + Map ID
# Phase 5: Supabase URL + service-role key (server-only), Turnstile site key + secret, Resend API key + sender
# Phase 6: Cal.com API credential + webhook secret (server-only), internal retry route secret
